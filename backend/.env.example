# ========== 必填 ==========
# MySQL 连接（请改为你的用户名、密码、主机、库名）
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/health_db

# JWT 签名密钥（生产环境务必使用足够长的随机字符串）
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# ========== 可选 ==========
# DeepSeek 对话（不配置则 /chat 不可用）
# 申请地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# DeepSeek 模型名（默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# 本地/内网 LLM 生成服务地址（心理报告图表解读）
LLM_GENERATE_URL=http://127.0.0.1:8000/generate

# 多模型协同主模型（默认 qwen3.6-plus）
PRIMARY_TEXT_MODEL=qwen3.6-plus
# 主模型异常时自动降级模型
PRIMARY_MODEL_FALLBACK=qwen-max
# DashScope Key（多模型协同链路）
QWEN_API_KEY=
# 熔断统计窗口（秒）
MODEL_FAILURE_WINDOW_SEC=300
# 熔断最小样本数
PRIMARY_CIRCUIT_MIN_SAMPLES=6
# 熔断错误率阈值
PRIMARY_CIRCUIT_ERROR_RATE=0.35
# 熔断连续异常阈值
PRIMARY_CIRCUIT_CONSECUTIVE=3
# 熔断冷却时间（秒）
PRIMARY_CIRCUIT_COOLDOWN_SEC=120
# 单模型最大重试次数
MODEL_RETRY_ATTEMPTS=3

# Access Token 有效期（分钟），默认 10080 = 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 微信小程序登录（jscode2session）
WECHAT_APPID=
WECHAT_SECRET=
