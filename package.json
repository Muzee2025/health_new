{
  "name": "health-new-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "assets:build": "node scripts/build-design-assets.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "assets:source-check": "node scripts/check-design-sources.mjs",
    "assets:source-test": "node --test scripts/tests/check-design-sources.test.mjs",
    "perf:build": "node scripts/build-frontend-audit.mjs",
    "perf:preview": "node scripts/serve-frontend-audit.mjs",
    "perf:check": "node scripts/check-frontend-loading.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,json}\" \"scripts/**/*.mjs\" \"public/sw.js\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,json}\" \"scripts/**/*.mjs\" \"public/sw.js\" \"*.{js,json}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.8",
    "chart.js": "^4.5.1",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "element-plus": "^2.6.3",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "16.5.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
